# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# Resend API key: https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where quote requests are delivered.
QUOTE_TO_EMAIL=quote@eliteautoinsurance.net

# Sender address. Must be on a domain you have verified in Resend.
# Until the domain is verified you can use: Elite Auto Insurance <onboarding@resend.dev>
QUOTE_FROM_EMAIL="Elite Auto Insurance <quote@eliteautoinsurance.net>"
